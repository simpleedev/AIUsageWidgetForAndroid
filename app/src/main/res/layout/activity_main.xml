<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1a1a1a">

    <!-- Top Tab Bar -->
    <LinearLayout
        android:id="@+id/tab_bar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:background="#121212"
        android:padding="4dp">

        <TextView
            android:id="@+id/tab_usage"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Usage"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#4A4A4A"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/tab_claude"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Claude"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:background="#222222"
            android:layout_marginStart="4dp"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/tab_chatgpt"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="ChatGPT"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:background="#222222"
            android:layout_marginStart="4dp"
            android:maxLines="1"/>

        <TextView
            android:id="@+id/tab_settings"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Settings"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#888888"
            android:background="#222222"
            android:layout_marginStart="4dp"
            android:maxLines="1"/>
    </LinearLayout>

    <!-- Account chips for the Claude and ChatGPT tabs: one per account, plus "+ Add account" -->
    <HorizontalScrollView
        android:id="@+id/account_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121212"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/account_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp"/>
    </HorizontalScrollView>

    <FrameLayout
        android:id="@+id/root_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Login WebView -->
        <LinearLayout
            android:id="@+id/loadingLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_login_instructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Please log in to Claude below. The app will automatically save your session cookie for the widget."
                android:textSize="14sp"
                android:background="#eeeeee"
                android:textColor="#333333"/>

            <!-- Only for a service with several accounts: drop an account that was never signed in -->
            <TextView
                android:id="@+id/btn_remove_pending_account"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:minHeight="32dp"
                android:text="Remove this account"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="#eeeeee"
                android:textColor="#C62828"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:textColor="#FF0000"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- One browser per service, so Claude and ChatGPT never share a page, popup or login check.
                 Only the current tab's browser is visible. Google sign-in popups open inside it. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <FrameLayout
                    android:id="@+id/browser_claude"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <WebView
                        android:id="@+id/webView_claude"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/browser_chatgpt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:visibility="gone">
                    <WebView
                        android:id="@+id/webView_chatgpt"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </FrameLayout>
        </LinearLayout>

        <!-- Success + Settings -->
        <ScrollView
            android:id="@+id/successLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1a1a1a"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/tv_success_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✓"
                    android:textSize="48sp"
                    android:textColor="#4CAF50"
                    android:includeFontPadding="false"/>

                <TextView
                    android:id="@+id/tv_success_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Claude Connected!"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="4dp"/>

                <TextView
                    android:id="@+id/tv_success_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Add the Claude Widget to your home screen and tap refresh."
                    android:textAlignment="center"
                    android:textColor="#B0B0B0"
                    android:textSize="14sp"/>

                <!-- Service-specific Settings Section -->
                <TextView
                    android:id="@+id/tv_service_settings_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Claude Settings"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp"/>

                <!-- Account name: shown on widgets, notifications and the Usage tab -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#2a2a2a"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Account Name"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:id="@+id/tv_account_name_hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shown on widgets and notifications once you add another account."
                        android:textColor="#808080"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/tv_account_label"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:text="Account 1"
                            android:textColor="#B0B0B0"
                            android:textSize="15sp"
                            android:maxLines="1"
                            android:ellipsize="end"/>

                        <TextView
                            android:id="@+id/btn_rename_account"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="Rename"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:background="#363636"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Usage Display -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#2a2a2a"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tv_usage_display_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show Usage As"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Show how much you've used or how much is left."
                        android:textColor="#808080"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <Spinner
                        android:id="@+id/spinner_usage_display"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#363636"
                        android:padding="8dp"
                        android:popupBackground="#363636"/>

                    <!-- Shared by both tabs: links Claude's and ChatGPT's "Show Usage As" -->
                    <CheckBox
                        android:id="@+id/cb_usage_display_linked"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:text="Use the same option for ChatGPT"
                        android:textColor="#B0B0B0"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Ongoing quota notification for only the current service -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#2a2a2a"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ongoing Notification"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Off by default. Tap the notification to open this service in the app, or use its Refresh button to update quota."
                        android:textColor="#808080"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp"/>

                    <CheckBox
                        android:id="@+id/cb_notification_service"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:text="Claude ongoing notification"
                        android:textColor="#B0B0B0"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Re-login button -->
                <TextView
                    android:id="@+id/btn_relogin"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="Re-login to Claude"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:background="#D4511E"
                    android:layout_marginTop="16dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Preserves your Google session for 1-tap sign-in"
                    android:textColor="#808080"
                    android:textSize="12sp"
                    android:layout_marginTop="6dp"/>

                <!-- Full Logout button -->
                <TextView
                    android:id="@+id/btn_full_logout"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Log out completely (clear Google session)"
                    android:textColor="#666666"
                    android:textSize="13sp"
                    android:layout_marginTop="8dp"/>

                <!-- Only when the service has more than one account -->
                <TextView
                    android:id="@+id/btn_remove_account"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center"
                    android:text="Remove this account"
                    android:textColor="#E57373"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"/>

            </LinearLayout>
        </ScrollView>

        <!-- Usage: every signed-in account, drawn with the same views as its home screen widget -->
        <ScrollView
            android:id="@+id/usageLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1a1a1a"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="4dp"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Usage"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"/>

                        <TextView
                            android:id="@+id/tv_usage_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Not refreshed yet"
                            android:textColor="#B0B0B0"
                            android:textSize="13sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/btn_usage_refresh"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Refresh"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:background="#363636"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/usage_cards"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <TextView
                    android:id="@+id/tv_usage_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#2a2a2a"
                    android:padding="20dp"
                    android:text="No accounts connected yet. Sign in on the Claude or ChatGPT tab, and your usage shows up here."
                    android:textColor="#B0B0B0"
                    android:textSize="14sp"
                    android:visibility="gone"/>

                <TextView
                    android:id="@+id/tv_usage_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:layout_marginTop="4dp"
                    android:text="Tap a card to open that account."
                    android:textColor="#808080"
                    android:textSize="12sp"/>
            </LinearLayout>
        </ScrollView>

        <!-- Shared Settings -->
        <ScrollView
            android:id="@+id/settingsLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#1a1a1a"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Shared settings for Claude and ChatGPT."
                    android:textColor="#B0B0B0"
                    android:textSize="14sp"
                    android:layout_marginBottom="20dp"/>

                <!-- Shared Auto Refresh Interval -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#2a2a2a"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Auto Refresh Interval"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="How often widgets and enabled notifications automatically update quota."
                        android:textColor="#808080"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <Spinner
                        android:id="@+id/spinner_interval"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#363636"
                        android:padding="8dp"
                        android:popupBackground="#363636"/>
                </LinearLayout>

                <!-- Usage tab refresh while the app is open -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#2a2a2a"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usage Tab Refresh"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="The Usage tab refreshes when you open the app, and then this often while it stays open."
                        android:textColor="#808080"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <Spinner
                        android:id="@+id/spinner_in_app_interval"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#363636"
                        android:padding="8dp"
                        android:popupBackground="#363636"/>
                </LinearLayout>

                <!-- Usage tab card taps -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#2a2a2a"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Usage Tab Card Tap"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Turn off to stay on the Usage tab when you tap a card. The card's refresh button still works."
                        android:textColor="#808080"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp"/>

                    <CheckBox
                        android:id="@+id/cb_usage_card_opens_account"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:text="Tap a card to open that account"
                        android:textColor="#B0B0B0"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Shared Widget Tap Action -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#2a2a2a"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Widget Tap Action"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="What happens when you tap the main body of a widget."
                        android:textColor="#808080"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <Spinner
                        android:id="@+id/spinner_tap_action"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="#363636"
                        android:padding="8dp"
                        android:popupBackground="#363636"/>
                </LinearLayout>

                <!-- Screen-on refresh -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#2a2a2a"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refresh When Screen Turns On"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Best effort while Android keeps the app process available. Skips another screen-on refresh if quota was refreshed in the last 2 minutes."
                        android:textColor="#808080"
                        android:textSize="12sp"
                        android:layout_marginBottom="8dp"/>

                    <CheckBox
                        android:id="@+id/cb_refresh_on_screen"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="0dp"
                        android:text="Refresh quota when the screen turns on"
                        android:textColor="#B0B0B0"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- Log -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="#2a2a2a"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Log"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_marginBottom="4dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View, copy, or clear the app refresh and login log."
                        android:textColor="#808080"
                        android:textSize="12sp"
                        android:layout_marginBottom="12dp"/>

                    <TextView
                        android:id="@+id/btn_view_log"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:text="View Log"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:background="#363636"/>
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
