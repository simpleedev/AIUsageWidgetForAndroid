<?xml version="1.0" encoding="utf-8"?>
<!--
  New widgets start at 4x2 cells and can't be shrunk below that; smaller sizes don't have
  room for the usage rows. They can still be made larger. minWidth/minHeight and
  minResizeWidth/minResizeHeight use the 70n - 30 dp cell size older launchers expect,
  and targetCellWidth/targetCellHeight set the default span on Android 12+.

  WidgetConfigActivity picks the account a new widget shows; it confirms straight away when
  there is only one. "reconfigurable" lets Android 12+ launchers change it later.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/chatgpt_widget_layout"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:configure="com.example.claudewidget.WidgetConfigActivity"
    android:widgetFeatures="reconfigurable"
    android:previewImage="@drawable/ic_chatgpt">
</appwidget-provider>
