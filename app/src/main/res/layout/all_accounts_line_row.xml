<?xml version="1.0" encoding="utf-8"?>
<!--
  One row of the All Accounts list widget. Usually holds one entry; a wide widget puts several
  side by side. Rows take the height their entries need, plus an equal share of what's left.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/all_accounts_line_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="horizontal"
    android:showDividers="middle"
    android:divider="@drawable/widget_line"
    android:dividerPadding="4dp" />
