<?xml version="1.0" encoding="utf-8"?>
<!--
  One account in the All Accounts list widget, with medium (8dp) bars.
  all_accounts_line.xml is the compact version, with the same ids, structure and spacers;
  AllAccountsLayout picks the largest that fits, so the bars grow when there are fewer
  accounts. Sizes here are what AllAccountsLayout.cardHeight() estimates for its density;
  change both together.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_root"
    tools:ignore="UselessLeaf"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingHorizontal="4dp"
    android:paddingVertical="2dp">

    <!-- Spare height goes to these spacers: half a share above the title and below the last
         row, half between the title and its rows, and a full share between rows. Half +
         half meet at each divider, so the gaps between accounts match those inside one.
         FrameLayouts, not the empty TextViews the other widget layouts use: a list row sizes
         itself to its entry, and an empty TextView would still claim a line of text height. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/iv_card_icon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/ic_claude" />
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
        <!-- Only when something is wrong: offline, an error, or not refreshed yet -->
        <TextView
            android:id="@+id/tv_last_update"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textColor="#BFFFFFFF"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:text="Session"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
        <ProgressBar
            android:id="@+id/pb_session"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="8dp"
            android:layout_marginHorizontal="6dp"
            android:progressDrawable="@drawable/custom_progress_bar"
            android:max="100"
            android:progress="0" />
        <TextView
            android:id="@+id/tv_session_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="62dp"
            android:gravity="end"
            android:text="--"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
        <TextView
            android:id="@+id/tv_session_reset"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:textColor="#BFFFFFFF"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:text="Weekly"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
        <ProgressBar
            android:id="@+id/pb_weekly"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="8dp"
            android:layout_marginHorizontal="6dp"
            android:progressDrawable="@drawable/custom_progress_bar"
            android:max="100"
            android:progress="0" />
        <TextView
            android:id="@+id/tv_weekly_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="62dp"
            android:gravity="end"
            android:text="--"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
        <TextView
            android:id="@+id/tv_weekly_reset"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:textColor="#BFFFFFFF"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Shown and hidden together with fable_row -->
    <FrameLayout
        android:id="@+id/fable_gap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/fable_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="52dp"
            android:text="Fable"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
        <ProgressBar
            android:id="@+id/pb_fable"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="8dp"
            android:layout_marginHorizontal="6dp"
            android:progressDrawable="@drawable/custom_progress_bar"
            android:max="100"
            android:progress="0" />
        <TextView
            android:id="@+id/tv_fable_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="62dp"
            android:gravity="end"
            android:text="--"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:includeFontPadding="false"
            android:maxLines="1" />
        <TextView
            android:id="@+id/tv_fable_reset"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="end"
            android:textColor="#BFFFFFFF"
            android:textSize="10sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.5" />

</LinearLayout>
